          <mxGeometry x="1090" y="850" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="aerocivil" value="&lt;b&gt;Aerocivil&lt;/b&gt;&lt;br&gt;[Sistema externo] — NUEVO&lt;br&gt;&lt;br&gt;Regula vuelos inter-sede" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3372C;strokeColor=#8C241B;fontColor=#ffffff;arcSize=10;fontSize=10;" vertex="1" parent="1">
