        <mxCell id="erp" value="&lt;b&gt;ERP universitario&lt;/b&gt;&lt;br&gt;[Sistema externo] — NUEVO&lt;br&gt;&lt;br&gt;Datos de usuarios por sede" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3372C;strokeColor=#8C241B;fontColor=#ffffff;arcSize=10;fontSize=10;" vertex="1" parent="1">
