        <!-- Flujos actores -->
        <mxCell id="e1" value="Monitorea flota y confirma entregas" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="operador" target="sistema"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="Envía solicitud de reparto" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="solicitante" target="sistema"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="Configura destinos y flota" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="admin" target="sistema"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="Marca drone reparado" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tecnico" target="sistema"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="Administra red completa" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="superadmin" target="sistema"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="Administra su sede" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="coordinador" target="sistema"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Flujos sistemas externos -->
        <mxCell id="e7" value="← condiciones de vuelo" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="clima" target="sistema"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="↔ autorización de ruta" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="controlAereo" target="sistema"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="→ alerta de fallo" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sistema" target="alertas"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="↔ autorización inter-sede" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aerocivil" target="sistema"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="← datos de usuarios por sede" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="erp" target="sistema"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="→ métricas de eficiencia" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sistema" target="analytics"><mxGeometry relative="1" as="geometry" /></mxCell>
