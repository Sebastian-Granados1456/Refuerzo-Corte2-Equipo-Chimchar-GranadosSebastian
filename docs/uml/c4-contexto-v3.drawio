        </mxCell>

        <mxCell id="analytics" value="&lt;b&gt;Analytics platform&lt;/b&gt;&lt;br&gt;[Sistema externo] — NUEVO&lt;br&gt;&lt;br&gt;Recibe métricas de eficiencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3372C;strokeColor=#8C241B;fontColor=#ffffff;arcSize=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="420" width="190" height="130" as="geometry" />
