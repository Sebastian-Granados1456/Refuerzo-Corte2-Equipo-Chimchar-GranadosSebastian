          <mxGeometry x="1230" y="480" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bdFlota" value="&lt;b&gt;BD Flota&lt;/b&gt;&lt;br&gt;[Contenedor: BD]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1230" y="580" width="110" height="80" as="geometry" />
        </mxCell>

        <!-- Sistemas externos (rojo) -->
