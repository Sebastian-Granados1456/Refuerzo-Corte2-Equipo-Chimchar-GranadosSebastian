        <mxCell id="servFlota" value="&lt;b&gt;Servicio de Flota&lt;/b&gt;&lt;br&gt;[Contenedor]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="940" y="180" width="190" height="80" as="geometry" />
