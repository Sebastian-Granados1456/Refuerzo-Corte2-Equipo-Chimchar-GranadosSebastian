        <mxCell id="plataformaAnalytics" value="Plataforma&lt;br&gt;Analytics&lt;br&gt;[Sistema externo]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3372C;strokeColor=#8C241B;fontColor=#ffffff;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1370" y="390" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- Flujos usuarios -->
        <mxCell id="f1" value="HTTPS" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="operador" target="appWeb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="HTTPS" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="superadmin" target="panelSuperadmin"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Flujos al gateway -->
        <mxCell id="f3" value="HTTPS" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="appWeb" target="gateway"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="HTTPS" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="panelSuperadmin" target="gateway"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Gateway -> servicios -->
        <mxCell id="f5" value="interno" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gateway" target="servMisiones"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="interno" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gateway" target="servFlota"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" value="interno" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gateway" target="servRutas"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" value="interno" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gateway" target="servAnalytics"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Servicios -> BD -->
        <mxCell id="f9" value="JDBC" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="servMisiones" target="bdMisiones"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" value="JDBC" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="servFlota" target="bdFlota"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Servicios -> sistemas externos -->
        <mxCell id="f11" value="HTTP" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="servRutas" target="apiClima"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f12" value="REST" style="endArrow=classic;html=1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="servAnalytics" target="plataformaAnalytics"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
