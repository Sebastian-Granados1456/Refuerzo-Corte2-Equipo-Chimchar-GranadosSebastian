<mxfile host="app.diagrams.net">
  <diagram name="C4 Contenedores - SkyCampus Enterprise" id="c4-contenedores-v3">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="&lt;b&gt;[Diagrama de Contenedores] SkyCampus Enterprise&lt;/b&gt;&lt;br&gt;Nivel 2 del modelo C4" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- Usuarios -->
        <mxCell id="operador" value="Operador / Admin / Técnico&lt;br&gt;[Persona, por sede]" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="superadmin" value="Superadmin / Coordinador&lt;br&gt;[Persona, red completa]" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- Límite del sistema -->
        <mxCell id="limite" value="SkyCampus Enterprise" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="1240" height="700" as="geometry" />
        </mxCell>

        <!-- Contenedores frontend -->
        <mxCell id="appWeb" value="&lt;b&gt;App Web Operadores&lt;/b&gt;&lt;br&gt;[Contenedor: por sede]&lt;br&gt;&lt;br&gt;Panel de flota y misiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="panelSuperadmin" value="&lt;b&gt;Panel Superadmin&lt;/b&gt;&lt;br&gt;[Contenedor]&lt;br&gt;&lt;br&gt;Vista de la red completa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="260" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gateway" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;[Contenedor]&lt;br&gt;&lt;br&gt;Enruta a los servicios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="185" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Servicios -->
