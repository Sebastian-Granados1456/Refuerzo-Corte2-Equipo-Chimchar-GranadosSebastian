<mxfile host="app.diagrams.net">
  <diagram name="C4 Contexto - SkyCampus MVP" id="c4-contexto">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="&lt;b&gt;[Diagrama de Contexto] SkyCampus MVP&lt;/b&gt;&lt;br&gt;Nivel 1 del modelo C4" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="400" height="50" as="geometry" />
        </mxCell>

        <mxCell id="operador" value="&lt;b&gt;Operador de drones&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Asigna misiones y monitorea la flota" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="60" width="200" height="180" as="geometry" />
        </mxCell>

        <mxCell id="solicitante" value="&lt;b&gt;Solicitante&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Pide el reparto de un documento" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="0" y="410" width="200" height="180" as="geometry" />
        </mxCell>

        <mxCell id="admin" value="&lt;b&gt;Admin&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Configura destinos y flota" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="410" width="200" height="180" as="geometry" />
        </mxCell>

        <mxCell id="sistema" value="&lt;b&gt;SkyCampus App&lt;/b&gt;&lt;br&gt;[Sistema de software]&lt;br&gt;&lt;br&gt;Registra solicitudes de reparto, asigna drones y registra el estado de cada misión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;arcSize=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="420" width="300" height="160" as="geometry" />
        </mxCell>

        <mxCell id="nota" value="MVP sin sistemas externos: los drones se controlan localmente, sin API externa." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="660" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Solicitante -->
        <mxCell id="e1" value="Envía solicitud de reparto&lt;br&gt;(origen, destino, tipo de documento)" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.35;entryX=0;entryY=0.35;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="solicitante" target="sistema">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="Devuelve código de misión&lt;br&gt;y estado de la entrega" style="endArrow=classic;html=1;fontSize=10;exitX=0;exitY=0.65;entryX=1;entryY=0.65;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sistema" target="solicitante">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="22" as="offset" /></mxGeometry>
        </mxCell>

        <!-- Operador -->
        <mxCell id="e3" value="Asigna drone a la misión&lt;br&gt;y confirma la entrega" style="endArrow=classic;html=1;fontSize=10;exitX=0.35;exitY=1;entryX=0.35;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="operador" target="sistema">
          <mxGeometry relative="1" as="geometry"><mxPoint x="-85" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="Muestra solicitudes pendientes&lt;br&gt;y estado de la flota&lt;br&gt;(batería, disponibilidad)" style="endArrow=classic;html=1;fontSize=10;exitX=0.65;exitY=0;entryX=0.65;entryY=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sistema" target="operador">
          <mxGeometry relative="1" as="geometry"><mxPoint x="90" y="0" as="offset" /></mxGeometry>
        </mxCell>

        <!-- Admin -->
        <mxCell id="e5" value="Registra drones&lt;br&gt;y destinos fijos" style="endArrow=classic;html=1;fontSize=10;exitX=0;exitY=0.35;entryX=1;entryY=0.35;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="admin" target="sistema">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e6" value="Muestra la configuración&lt;br&gt;actual de flota y destinos" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.65;entryX=0;entryY=0.65;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sistema" target="admin">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="22" as="offset" /></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
